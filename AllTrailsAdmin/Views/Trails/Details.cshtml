@using Microsoft.AspNetCore.Html
@model AllTrailsAdmin.Models.Trail

@{
    ViewData["Title"] = "Details";
}

<h1 class="mb-4">Details - @Html.DisplayFor(model => model.Title)</h1>

<img src="@Model.ImageUrl" alt="@Model.Title" class="w-25"/>
<div>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @* @Html.DisplayFor(model => model.Description) *@

        @{
            var descriptionWithBreaks = new HtmlString (Model.Description
                .Replace("\r\n", "<br />")
                .Replace("\n", "<br />")
                .Replace("\r", "<br />")
                );
        }

        @descriptionWithBreaks
            

        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Length)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Length)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ElevationGain)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ElevationGain)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Location)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Location)
        </dd>
    </dl>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CategoryId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Category.Title) @* Category nav property *@
        </dd>
        @* <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Category)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Category)
        </dd> *@
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("administrator"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a>
    }   
    <a asp-action="Index">Back to List</a>
</div>
