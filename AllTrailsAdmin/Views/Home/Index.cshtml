@{
    ViewData["Title"] = "Home Page";

    string name = "Alex";
    bool showMessage = true;
}

<div class="text-center">
    <h1 class="display-4">Welcome Alex</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<p>
    Hello @name!
    <br />
    @if(showMessage) // is true
    {
        <span>This is my first ASP.NET Core MVC Web App.</span>
    }
    else
    {
        <span>Nothing to say. :(</span>
    }
</p>

@{
    // My collection of fruits
    List<string> fruits = new List<string>();
    // List<string> fruits = new List<string> { "Apple", "Banana", "Cheery" };
    fruits.Add("Apple");
    fruits.Add("Banana");
    fruits.Add("Cherry");
}

<h1>
    My Favorite Fruits
</h1>
<ul>
    @foreach (string fruit in fruits)
    {
        <li>
            The value of item: @fruit
        </li>
    }
</ul>

@{

    //Create an list of objects with 3 properties; id, name, email. Add 3 people to the list.
    //Then output on the page
    var people = new List<Person>
    {
        new Person{Id=1, Name="abc", Email = "efe@afdf.com"},
        new Person{Id=2, Name="abcd", Email = "aefe@afdf.com"},
        new Person{Id=3, Name="abcddf22", Email = "abcddf22@afdf.com"}
    };    
}

<h2>Annoying Star Wars Characters</h2>
    <ul>
        @foreach(var person in people)
        {
            <li>
                @person.Id - @person.Name - @person.Email
            </li>
        }
    </ul>
<div class="row">
    <div class="col-4">
        <img src="~/images/F1.JPG" alt="F1" class="thumbnail" />
    </div>
</div>
